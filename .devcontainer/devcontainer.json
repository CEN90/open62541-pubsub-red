{
  "name": "open62541_debian",
  "build": {
    "dockerfile": "Dockerfile",
    "context": "..",
  },
  "settings": {
    "terminal.integrated.shell.linux": "/bin/bash",
  },
  "runArgs": [
    "--cap-add=SYS_PTRACE",
    "--security-opt",
    "seccomp=unconfined",
    "--net=host",
    "-p",
    "10001:10001/udp",
    "-p",
    "4840:4840/udp"
  ],
  "forwardPorts": [
    4840
  ],
}
